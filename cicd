# ================================ Package-Jobs ================================
# => Create & push image to MTR (Quay) via Gradle plugin -> jib (no Docker needed!)
# => Previously cached build-files are being referred to
# => Snapshot: Branch name needs to have prefix defined (e.g. /task, /feature , /bug) or be default(main/master)
# => Release: Git Tag has to fulfill certain criteria (e.g., v1.2.3) & be protected 

.package:snapshot:
  extends: .gradle_job_template
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH || $CI_COMMIT_BRANCH =~ /^feature/ || $CI_COMMIT_BRANCH =~ /^task/ || $CI_COMMIT_BRANCH =~ /^bug/ || $CI_PIPELINE_SOURCE == 'merge_request_event'
  script:
    - export IMAGE_TAG=$(gradle cV -q -Prelease.quiet)-$CI_PIPELINE_ID
    - export IMAGE_FQDN=$IMAGE_REPO:$IMAGE_TAG
    - echo IMAGE_TAG=$IMAGE_TAG >> package.env
    - echo IMAGE_FQDN=$IMAGE_FQDN >> package.env
    - gradle jib $GRADLE_SUFFIX
  artifacts:
    reports:
      dotenv: package.env

.package:release:
  extends: .gradle_job_template
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/'
  script:
    - export IMAGE_TAG=$(gradle cV -q -Prelease.quiet)
    - export IMAGE_FQDN=$IMAGE_REPO:$IMAGE_TAG
    - echo IMAGE_TAG=$IMAGE_TAG >> package.env
    - echo IMAGE_FQDN=$IMAGE_FQDN >> package.env
    - if [ "$SKIP_RELEASE" == "false" ]; then echo "creating release image" ; fi;
    - if [ "$SKIP_RELEASE" == "false" ]; then gradle jib $GRADLE_SUFFIX ; fi;   
    - if [ "$SKIP_RELEASE" == "false" ]; then export IMAGE_DIGEST=$(cat build/jib-image.digest) ; fi;
    - if [ "$SKIP_RELEASE" == "false" ]; then echo IMAGE_DIGEST=$IMAGE_DIGEST >> package.env ; fi;
  artifacts:
    reports:
      dotenv: package.env

.package-release-data:
  image: mtr.devops.telekom.de/magbus/kustomize-kubectl-helm
  allow_failure: true
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/ && $SKIP_RELEASE == "false"
  variables:
    PACKAGE: dependencies 
  script:
    - echo $IMAGE_DIGEST > image-digest.txt
    - echo "Publish to ${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/packages/generic/${PACKAGE}/${CI_COMMIT_TAG}/image-digest.txt"
    - 'curl --header "JOB-TOKEN: $CI_JOB_TOKEN" --upload-file image-digest.txt "${CI_API_V4_URL}/projects/${CI_PROJECT_ID}/packages/generic/${PACKAGE}/${CI_COMMIT_TAG}/image-digest.txt"'
  dependencies:
    - package:release


# ================================ Image Signing ================================
# => Jobs will sign snapshot/release image previously created by package-job
# => Private keys used for signing are stored in K8s secrets for every environment
# => Branch: Branch name needs to have prefix defined (e.g. /task, /feature , /bug)
# => Playground: Only works with default Branch (main/master)
# => SIT, CIT2, CIT4, PrePROD, PROD: Git Tag has to fulfill certain criteria (e.g., v1.2.3) & be protected 

# Pre-define cluster & context to be worked on incl. credentials
.prepare_kubectl: &prepare_kubectl
  - kubectl config set-cluster $KUBERNETES_SERVER_NAME --server=$KUBERNETES_SERVER_URL
  - kubectl config set-credentials $KUBERNETES_USER --token=$KUBERNETES_DEPLOY_TOKEN
  - kubectl config set-context $KUBERNETES_NAMESPACE --cluster=$KUBERNETES_SERVER_NAME --namespace=$KUBERNETES_NAMESPACE --user=$KUBERNETES_USER
  - kubectl config use-context $KUBERNETES_NAMESPACE

# Image to be used when doing any Kubernetes Jobs (Deployments)
.kubectl_job_template:
  image: mtr.devops.telekom.de/magbus/kustomize-kubectl-helm
  before_script:
    - *prepare_kubectl

.sign-image:
  extends: .kubectl_job_template
  script:
    - export DOCKER_CONFIG=$(pwd)/.docker
    - mkdir -p $DOCKER_CONFIG
    - cosign login $DOCKER_REGISTRY_ADDRESS -u $MTR_DEVOPS_USERNAME -p $MTR_DEVOPS_PASSWORD
    - cosign sign --key k8s://$KUBERNETES_NAMESPACE/cosign $IMAGE_FQDN

.sign-image:dev:
  extends: .sign-image
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
  variables:
    KUBERNETES_SERVER_URL: $KUBERNETES_SERVER_URL_dev
    KUBERNETES_SERVER_NAME: $KUBERNETES_SERVER_NAME_dev
    KUBERNETES_USER: $KUBERNETES_USER_dev
    KUBERNETES_DEPLOY_TOKEN: $KUBERNETES_DEPLOY_TOKEN_dev
    KUBERNETES_NAMESPACE: $KUBERNETES_NAMESPACE_dev
  dependencies:
    - package:snapshot


# ================================ Deployment (Playground, Branch, SIT, CIT2, CIT4, PrePROD, PROD) ================================
# => Requirement: All .yml-files defined below for deployment need to be in a folder called "k8s"
# => Branch: Branch name needs to have prefix defined (e.g. /task, /feature , /bug)
# => Playground: Only works with default Branch (main/master)
# => SIT, CIT2, CIT4, PrePROD, PROD: Git Tag has to fulfill certain criteria (e.g., v1.2.3) & be protected
# => ENV-VARIABLES are pre-defined per environment, no changes necessary

.deploy:
  extends: .kubectl_job_template
  script:
    - mkdir -p kubernetes
    - echo $CI_ENVIRONMENT_TIER
    - if [ -f k8s/service.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/service.yml > kubernetes/service.yml; fi;
    - if [ -f k8s/hpa.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/hpa.yml > kubernetes/hpa.yml; fi;
    - if [ -f k8s/pdb.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/pdb.yml > kubernetes/pdb.yml; fi;
    - if [ -f k8s/servicemonitor.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/servicemonitor.yml > kubernetes/servicemonitor.yml; fi;
    - if [ -f k8s/nonprod-ingress.yml  ] && [ "$CI_ENVIRONMENT_TIER" != "production" ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/nonprod-ingress.yml > kubernetes/nonprod-ingress.yml; fi;
    - if [ -f k8s/ingress.yml  ] && [ "$CI_ENVIRONMENT_TIER" = "production" ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/ingress.yml > kubernetes/ingress.yml; fi;
    - if [ -f k8s/configmap.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/configmap.yml > kubernetes/configmap.yml; fi;
    - if [ -f k8s/deployment.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/deployment.yml > kubernetes/deployment.yml; fi;
    - if [ -f k8s/job.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/job.yml > kubernetes/job.yml; fi;
    - if [ -f k8s/cronjob.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/cronjob.yml > kubernetes/cronjob.yml; fi;
    - if [ -f k8s/service.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/service.yml | kubectl apply -f -; fi;
    - if [ -f k8s/hpa.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/hpa.yml | kubectl apply -f -; fi;
    - if [ -f k8s/pdb.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/pdb.yml | kubectl apply -f -; fi;
    - if [ -f k8s/servicemonitor.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/servicemonitor.yml | kubectl apply -f -; fi;
    - if [ -f k8s/nonprod-ingress.yml  ] && [ "$CI_ENVIRONMENT_TIER" != "production" ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/nonprod-ingress.yml | kubectl apply -f -; fi;
    - if [ -f k8s/ingress.yml  ] && [ "$CI_ENVIRONMENT_TIER" = "production" ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/ingress.yml | kubectl apply -f -; fi;
    - if [ -f k8s/configmap.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/configmap.yml | kubectl apply -f -; fi;
    - if [ -f k8s/secret.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/secret.yml | kubectl apply -f -; fi;
    - if [ -f k8s/deployment.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/deployment.yml | kubectl apply -f -; fi;
    - if [ -f k8s/deployment.yml  ]; then kubectl rollout status deployment/${APP_NAME}; fi;
    - if [ -f k8s/job.yml  ]; then kubectl -n ${KUBERNETES_NAMESPACE} --selector=job-name=${APP_NAME} delete job || true; fi;
    - if [ -f k8s/job.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/job.yml | kubectl apply -f -; fi;
    - if [ -f k8s/cronjob.yml  ]; then kubectl delete cronjob -l ${APP_NAME}=cronjob || true ; fi;
    - if [ -f k8s/cronjob.yml  ]; then envsubst "$(printf '${%s} ' $(env | cut -d'=' -f1))" < k8s/cronjob.yml | kubectl apply -f -; fi;
  artifacts:
    when: always
    paths:
      - kubernetes/*
    expire_in: 14 days

.deploy:dev:
  extends: .deploy
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
  variables:
    KUBERNETES_SERVER_URL: $KUBERNETES_SERVER_URL_dev
    KUBERNETES_SERVER_NAME: $KUBERNETES_SERVER_NAME_dev
