variables:
  KUBERNETES_RUNNER: 
  DOCKER_REGISTRY_ADDRESS: 
  DOCKER_REGISTRY_NAMESPACE: 
  IMAGE_REPO: "$DOCKER_REGISTRY_ADDRESS/$DOCKER_REGISTRY_NAMESPACE/$APP_NAME"
  IMAGE_PULL_SECRET_NAME: 
  FAIL_WHEN_COSIGN_VERIFICATION_FAILED_VALUE: "true"
  CONFLUENCE_GROUP_ID: 
  SONAR_GROUP_KEY: 
  SONAR_PROJECT_KEY: "$SONAR_GROUP_KEY:$APP_NAME"
  SONAR_HOST_URL: 

# Pre-define Runner and retry on known failures
default:
  tags:
    - $KUBERNETES_RUNNER
  retry:
    max: 2
    when:
      - unknown_failure
      - runner_system_failure
      - api_failure
      - scheduler_failure
      - data_integrity_failure 

# ================================ Utility ================================

# Check default branch pipeline for release
.check-main:
  image: kustomize-kubectl-helm
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/ && $SKIP_CHECK == "false" 
  script:
    - |
     response_list=$(curl --request GET -H "Authorization: Bearer $MONITOR_ACCESS" --form ref=$CI_DEFAULT_BRANCH  --form sha=$CI_COMMIT_SHA "https://gitlab.com/api/v4/projects/$CI_PROJECT_ID/pipelines")
    - echo $response_list
    - latest_response=$(echo $response_list | jq '.[0]')
    - status=$(echo $latest_response | jq .status)
    - echo $status
    - if [ ${status} != "\"success\"" ]; then echo "default branch pipeline is not successful" ; fi;
    - if [ ${status} != "\"success\"" ]; then exit 1 ; fi;

#export-sbom
.export-merged-sbom:
  image: docker:20.10.14-dind
  before_script:
    - apk add --update jq curl
  script:
    - |
      curl --header "Authorization: Bearer $PRIVATE_TOKEN_SBOM" --output export.sh --url "https://gitlab.com/api/v4/snippets/3550/raw"
    - /bin/sh export.sh
  artifacts:
    paths:
      - "gl-sbom-merged-*.cdx.json"

# Transfer README to Confluence
.transfer-readme:
  image: gitlab-api:1
  allow_failure: true
  script:
    - python3 /src/gitlab_api -e transfer_md -p $CI_PROJECT_ID -f README.md -t $CONFLUENCE_GROUP_ID
  only:
    refs:
      - master
      - main
    changes:
      - README.md

# Quality Report of Code is automatically being published in Pages section of GitLab Project
.pages:
  script:
    - mkdir public
    - mv gl-code-quality-report.html public/index.html
  artifacts:
    expire_in: '2 weeks'
    paths:
      - public
    when: always
  allow_failure: true
  only:
    refs:
      - master
      - main

