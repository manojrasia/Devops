# Builds and runs unit-tests with code coverage (extracted from jacocoTestReport)
.unit-test:
  extends: .gradle_job_template
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH || $CI_COMMIT_BRANCH =~ /^feature/ || $CI_COMMIT_BRANCH =~ /^task/ || $CI_COMMIT_BRANCH =~ /^bug/ || $CI_PIPELINE_SOURCE == 'merge_request_event'
  script:
    - gradle build $GRADLE_SUFFIX
    - awk -F, '{ instructions += $4 + $5; covered += $5 } END { print covered, "/", instructions, " instructions covered"; print 100*covered/instructions, "% covered" }' build/reports/jacoco/test/jacocoTestReport.csv
    - echo start gradle dependencies
    - gradle -q dependencies > gradle-dependencies.txt
    - gradle generateGradleLintReport
  coverage: '/\d{0,3}\.?\d{0,9} % covered/'
  artifacts:
    when: always
    paths:
      - build/reports/jacoco/test/jacocoTestReport.xml
      - gradle-dependencies.txt
      - build/reports/gradleLint/*
    reports:
      junit: 
        - build/test-junit-xml/TEST-*.xml

