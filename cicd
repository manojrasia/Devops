# Separate job to calculate code coverage, that uses cobertura
.coverage:
  image: registry.gitlab.com/haynes/jacoco2cobertura:1.0.7
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH || $CI_COMMIT_BRANCH =~ /^feature/ || $CI_COMMIT_BRANCH =~ /^task/ || $CI_COMMIT_BRANCH =~ /^bug/ || $CI_PIPELINE_SOURCE == 'merge_request_event'
  script:
    - mkdir -p build/reports/jacoco/test
    - python /opt/cover2cover.py build/reports/jacoco/test/jacocoTestReport.xml $CI_PROJECT_DIR/src/main/java/ > build/reports/jacoco/test/cobertura.xml
  needs: ["unit-test"]
  artifacts:
    reports:
      coverage_report:
        coverage_format: cobertura
        path: build/reports/jacoco/test/cobertura.xml
    # Shows in GitLab which Lines are covered by "coverage" (green ones)


.sonar-mr:
  extends: .gradle_job_template_without_cache
  rules:
    - if: $CI_PIPELINE_SOURCE == 'merge_request_event'
  variables:
    SONAR_USER_HOME: "${CI_PROJECT_DIR}/.sonar"  # Defines the location of the analysis task cache
    GIT_DEPTH: "0"  # Tells git to fetch all the branches of the project, required by the analysis task
  script:
    - echo "SONAR_BYPASS:$SONAR_BYPASS"
    - |
      if [ "$SONAR_BYPASS" = "true" ]; then
        echo "Running with -Dsonar.qualitygate.wait=false"
        gradle build sonar $GRADLE_SUFFIX -Dsonar.verbose=true -Dsonar.qualitygate.wait=false -Dsonar.pullrequest.key=$CI_MERGE_REQUEST_IID -Dsonar.pullrequest.branch=$CI_COMMIT_REF_NAME -Dsonar.pullrequest.base=$CI_DEFAULT_BRANCH
      else
        echo "Running with -Dsonar.qualitygate.wait=true"
        gradle build sonar $GRADLE_SUFFIX -Dsonar.verbose=true -Dsonar.qualitygate.wait=true -Dsonar.pullrequest.key=$CI_MERGE_REQUEST_IID -Dsonar.pullrequest.branch=$CI_COMMIT_REF_NAME -Dsonar.pullrequest.base=$CI_DEFAULT_BRANCH
      fi
  cache:
    key: "${CI_JOB_NAME}"
    paths:
      - .sonar/cache

.sonar:
  extends: .gradle_job_template_without_cache
  variables:
    SONAR_USER_HOME: "${CI_PROJECT_DIR}/.sonar"  # Defines the location of the analysis task cache
    GIT_DEPTH: "0"  # Tells git to fetch all the branches of the project, required by the analysis task
  rules:
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH || $CI_COMMIT_BRANCH =~ /^feature/ || $CI_COMMIT_BRANCH =~ /^task/ || $CI_COMMIT_BRANCH =~ /^bug/
  script:
    - gradle build sonar $GRADLE_SUFFIX -Dsonar.verbose=true -Dsonar.qualitygate.wait=false 
  cache:
    key: "${CI_JOB_NAME}"
    paths:
      - .sonar/cache

